  <compiler>
    <compiler>
      <name>GNU_Target_ARM64_SIMULATOR_C</name>
      <config>
        <config>
          <key>WHITEBOX</key>
          <value>YES</value>
          <key>COVERAGE_TYPE</key>
          <value>Statement+Branch</value>
          <key>VCAST_COLLAPSE_STD_HEADERS</key>
          <value>COLLAPSE_SYSTEM_HEADERS</value>
          <key>C_EXECUTE_CMD</key>
          <value>qemu-aarch64 -L $(QEMU_LIBRARY)</value>
          <key>C_COMPILER_HIERARCHY_STRING</key>
          <value>GNU Target_ARM64_SIMULATOR_C</value>
          <key>C_PREPROCESS_CMD</key>
          <value>$(VCAST_COMPILER_GCC) -E -ftrack-macro-expansion=0 -C -march=armv8-a -mcpu=cortex-a57 -mtune=cortex-a57 --sysroot=/poky/build/tmp-glibc/work/aarch64-oe-linux/wpa-supplicant/git-r5.2/recipe-sysroot</value>
          <key>C_COMPILE_CMD</key>
          <value>$(VCAST_COMPILER_GCC) -c -g -march=armv8-a -mcpu=cortex-a57 -mtune=cortex-a57 --sysroot=/poky/build/tmp-glibc/work/aarch64-oe-linux/wpa-supplicant/git-r5.2/recipe-sysroot</value>
          <key>C_DEBUG_CMD</key>
          <value>bash ./simulator_qemu_debug.sh aarch64 12345 aarch64 $(QEMU_LIBRARY)</value>
          <key>C_LINK_CMD</key>
          <value>$(VCAST_COMPILER_GCC) -g -march=armv8-a -mcpu=cortex-a57 -mtune=cortex-a57 --sysroot=/poky/build/tmp-glibc/work/aarch64-oe-linux/wpa-supplicant/git-r5.2/recipe-sysroot</value>
          <key>C_EDG_FLAGS</key>
          <value>-w --gcc --gnu_version 70300 --64_bit_target --x86_64</value>
          <key>VCAST_ENVIRONMENT_FILES</key>
          <value>/vcast/Linux_Genereal_cross_GNU/CFG/simulator_qemu_debug.sh</value>
          <key>VCAST_PREPROCESS_PREINCLUDE</key>
          <value>$(VECTORCAST_DIR)/DATA/gnu_native/intrinsics.h</value>
          <key>VCAST_ASSEMBLY_FILE_EXTENSIONS</key>
          <value>s</value>
          <key>VCAST_COMMAND_LINE_DEBUGGER</key>
          <value>TRUE</value>
          <key>VCAST_EXECUTE_WITH_STDOUT</key>
          <value>TRUE</value>
          <key>VCAST_ALT_WB_METHOD</key>
          <value>0</value>
          <key>VCAST_DISABLE_STD_WSTRING_DETECTION</key>
          <value>TRUE</value>
          <key>VCAST_HAS_LONGLONG</key>
          <value>TRUE</value>
          <key>VCAST_NO_SIGNAL</key>
          <value>TRUE</value>
          <key>VCAST_NO_STDIN</key>
          <value>TRUE</value>
        </config>
      </config>
    </compiler>
    <testsuite name="TestSuite">
      <group name="Group"/>
      <group name="group2"/>
      <group name="wpa_supplicant"/>
    </testsuite>
  </compiler>
